# Copy this file to .env and fill in your real values.
# .env is loaded by config.php — never commit the real .env file.

DB_HOST=localhost
DB_NAME=sunshine_db
DB_USER=sunshine_user
DB_PASS=change-this-password

# Long random string — used to sign JWTs. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_SECONDS=604800

# Comma-separated list of allowed frontend origins (no trailing slash).
FRONTEND_ORIGINS=http://localhost:3000

# Seed admin account — used only by scripts/seed.php
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@sunshinesocial.org
SEED_ADMIN_PASSWORD=change-this-immediately

# Seed demo clinic login — used only by scripts/seed.php
SEED_CLINIC_EMAIL=clinic@partnerclinic.example
SEED_CLINIC_PASSWORD=change-this-immediately

# --- Razorpay (get from your Razorpay Dashboard) ---
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# --- Receipt emails (uses PHP's built-in mail(), no SMTP setup needed) ---
RECEIPT_FROM_EMAIL=receipts@sunshinesocial.org

# --- WhatsApp Business API (via a BSP like Interakt, Gupshup, or AiSensy).
# If WHATSAPP_API_URL is unset, messages are logged instead of sent —
# safe default for local dev/demo. ---
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# --- SMS fallback (e.g. MSG91, Twilio). Same log-fallback if unset. ---
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SNSHIN

# --- Facebook/Instagram feed (optional — Social page shows a placeholder
# until these are set). Get these from your Meta Developer App — see
# lib/socialFeed.php for the full one-time setup walkthrough. ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

ENVIRONMENT=development
