# --- Database ---
# MySQL connection string, matching typical cPanel/shared-hosting MySQL.
# cPanel-created databases are usually named cpaneluser_dbname with a
# matching cpaneluser_dbuser — check your cPanel "MySQL Databases" screen.
DATABASE_URL="mysql://sunshine_user:sunshine_pass@localhost:3306/sunshine_db"

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated if you ever host the admin dashboard or clinic portal on
# a different domain than the main site, e.g.:
# FRONTEND_ORIGIN=https://sunshinesocial.org,https://admin.sunshinesocial.org
FRONTEND_ORIGIN=http://localhost:3000

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d

# --- Razorpay (get from Razorpay Dashboard) ---
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# --- Seed admin account (used only by prisma/seed.js) ---
SEED_ADMIN_EMAIL=admin@sunshinesocial.org
SEED_ADMIN_PASSWORD=change-this-immediately

# --- Phase 2: Email (80G receipts). If SMTP_HOST is unset, receipts are
# logged to the console instead of sent — safe default for local dev. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RECEIPT_FROM_EMAIL="Sunshine Social Foundation <receipts@sunshinesocial.org>"

# --- Phase 2: seed clinic login (used only by prisma/seed.js) ---
SEED_CLINIC_EMAIL=clinic@partnerclinic.example
SEED_CLINIC_PASSWORD=change-this-immediately

# --- Phase 3: WhatsApp Business API (via a BSP like Interakt, Gupshup, or
# AiSensy — all expose a similar REST send-message endpoint). If
# WHATSAPP_API_URL is unset, messages are logged to the console instead of
# sent — safe default for local dev/demo. ---
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# --- Phase 3: SMS fallback (e.g. MSG91, Twilio). Same console-log
# fallback if unset. ---
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SNSHIN
